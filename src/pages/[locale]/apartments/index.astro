---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ApartmentCard from '../../../components/ApartmentCard.astro';
import { LOCALES, type Locale } from '../../../i18n/locales';
import { useTranslations } from '../../../i18n/utils';
import { APARTMENTS } from '../../../data/apartments';
import { PAGE_META } from '../../../data/seo';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={PAGE_META.apartmentsIndex[locale].title}
  description={PAGE_META.apartmentsIndex[locale].description}
  path={['apartments']}
>
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">{t('site.name')}</p>
        <h1>{t('apartments.sectionTitle')}</h1>
        <p>{t('apartments.sectionSubtitle')}</p>
      </div>
      <div class="apartments-grid">
        {APARTMENTS.map((apartment, i) => (
          <ApartmentCard apartment={apartment} locale={locale} priority={i < 3} headingLevel="h2" />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .apartments-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.75rem;
  }
</style>
