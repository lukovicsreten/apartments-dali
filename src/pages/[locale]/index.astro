---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ApartmentCard from '../../components/ApartmentCard.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import Icon from '../../components/Icon.astro';
import { LOCALES, type Locale } from '../../i18n/locales';
import { useTranslations, localePath } from '../../i18n/utils';
import { APARTMENTS } from '../../data/apartments';
import { getApartmentImages } from '../../data/images';
import { SITE, whatsappHrefWithMessage } from '../../data/site';
import { PAGE_META } from '../../data/seo';
import { lodgingBusinessSchema, resolveImageUrls } from '../../lib/jsonld';
import StructuredData from '../../components/StructuredData.astro';
import heroImage from '../../assets/hero/budva.jpg';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const whatsappMessage: Record<Locale, string> = {
  sr: 'Zdravo! Zanima me smeštaj u Apartments Dali.',
  en: 'Hi! I would like to ask about a stay at Apartments Dali.',
  de: 'Hallo! Ich interessiere mich für einen Aufenthalt bei Apartments Dali.',
};

const heroAlt: Record<Locale, string> = {
  sr: 'Panorama Starog grada Budve i tvrđave Sveti Nikola, Crna Gora',
  en: 'Panoramic view of Budva Old Town and St. Nicholas fortress, Montenegro',
  de: 'Panoramablick auf die Altstadt von Budva und die Festung Sveti Nikola, Montenegro',
};

const site = Astro.site ?? new URL('https://apartmentsdali.com');
const businessImages = await resolveImageUrls(
  [heroImage, ...getApartmentImages('garden-view-apartment').slice(0, 1), ...getApartmentImages('studio-with-terrace').slice(0, 1)],
  site
);
const businessSchema = lodgingBusinessSchema({ site, locale, images: businessImages });
---

<BaseLayout
  locale={locale}
  title={PAGE_META.home[locale].title}
  description={PAGE_META.home[locale].description}
  path={[]}
>
  <Fragment slot="head">
    <StructuredData data={businessSchema} />
  </Fragment>

  <section class="hero">
    {heroImage && (
      <Image
        src={heroImage}
        alt={heroAlt[locale]}
        width={1920}
        height={671}
        widths={[640, 960, 1280, 1920, 2560]}
        sizes="100vw"
        format="webp"
        quality={78}
        loading="eager"
        fetchpriority="high"
        class="hero-img"
      />
    )}
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <p class="eyebrow eyebrow-light">{t('site.tagline')}</p>
      <h1>{t('hero.title')}</h1>
      <p class="hero-subtitle">{t('hero.subtitle')}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={localePath(locale, 'apartments')}>{t('hero.cta')}</a>
        <a class="btn btn-ghost" href={localePath(locale, 'contact')}>{t('hero.ctaContact')}</a>
      </div>
    </div>
  </section>

  <section class="section intro">
    <div class="container intro-grid">
      <div>
        <p class="eyebrow">{t('site.name')}</p>
        <h2>{t('intro.title')}</h2>
        <p>{t('intro.body')}</p>
        <div class="intro-actions">
          <a class="btn btn-primary" href={SITE.telHref}><Icon name="phone" /> {SITE.phoneDisplay}</a>
          <a class="btn btn-secondary" href={whatsappHrefWithMessage(whatsappMessage[locale])} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> {t('nav.whatsapp')}
          </a>
        </div>
      </div>
      <ul class="intro-stats">
        <li><Icon name="general" /><span>6 {locale === 'sr' ? 'jedinica' : locale === 'de' ? 'Einheiten' : 'units'}</span></li>
        <li><Icon name="wifi" /><span>{locale === 'sr' ? 'Besplatan WiFi svuda' : locale === 'de' ? 'Kostenloses WLAN überall' : 'Free WiFi everywhere'}</span></li>
        <li><Icon name="door" /><span>{locale === 'sr' ? 'Sopstveni ulaz' : locale === 'de' ? 'Privater Eingang' : 'Private entrance'}</span></li>
        <li><Icon name="accessible" /><span>{t('apartments.accessible')}</span></li>
      </ul>
    </div>
  </section>

  <section class="section section-bg-alt">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">{t('nav.apartments')}</p>
        <h2>{t('apartments.sectionTitle')}</h2>
        <p>{t('apartments.sectionSubtitle')}</p>
      </div>
      <div class="apartments-grid">
        {APARTMENTS.map((apartment, i) => (
          <ApartmentCard apartment={apartment} locale={locale} priority={i < 2} />
        ))}
      </div>
    </div>
  </section>

  <section class="section destination">
    <div class="container destination-grid">
      <div>
        <p class="eyebrow">Montenegro</p>
        <h2>{t('destination.title')}</h2>
        <p>{t('destination.body')}</p>
      </div>
      <ul class="destination-highlights">
        <li><Icon name="city" /><span>{locale === 'sr' ? 'Stari grad Budve' : locale === 'de' ? 'Altstadt von Budva' : 'Budva Old Town'}</span></li>
        <li><Icon name="beach" /><span>{locale === 'sr' ? 'Peščane plaže' : locale === 'de' ? 'Sandstrände' : 'Sandy beaches'}</span></li>
        <li><Icon name="mountain" /><span>{locale === 'sr' ? 'Crnogorska rivijera' : locale === 'de' ? 'Montenegrinische Riviera' : 'Montenegrin riviera'}</span></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container map-section">
      <div class="section-head">
        <p class="eyebrow">{t('map.title')}</p>
        <h2>{t('map.title')}</h2>
        <p>{t('map.body')}</p>
        <a class="btn btn-secondary" href={SITE.mapsShareUrl} target="_blank" rel="noopener">
          <Icon name="mapPin" /> {t('map.openInMaps')}
        </a>
      </div>
      <MapEmbed title={t('map.title')} />
    </div>
  </section>

  <section class="section section-bg-alt contact-cta">
    <div class="container contact-cta-inner">
      <div>
        <p class="eyebrow">{t('nav.contact')}</p>
        <h2>{t('contact.title')}</h2>
        <p>{t('contact.subtitle')}</p>
      </div>
      <div class="contact-cta-actions">
        <a class="btn btn-primary" href={SITE.telHref}><Icon name="phone" /> {SITE.phoneDisplay}</a>
        <a class="btn btn-accent" href={whatsappHrefWithMessage(whatsappMessage[locale])} target="_blank" rel="noopener">
          <Icon name="whatsapp" /> {t('nav.whatsapp')}
        </a>
        <a class="btn btn-secondary" href={localePath(locale, 'contact')}>{t('nav.contact')}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(30, 25, 20, 0.25) 0%, rgba(30, 25, 20, 0.35) 45%, rgba(20, 16, 12, 0.82) 100%);
  }

  .hero-content {
    position: relative;
    padding-block: 4rem;
    max-width: 760px;
  }

  .eyebrow-light {
    color: #f2d9c9;
  }

  .hero h1 {
    color: #fff;
    margin-bottom: 0.4rem;
  }

  .hero-subtitle {
    color: #f1ece2;
    font-size: 1.15rem;
    max-width: 32rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.75rem;
  }

  .intro-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.5rem;
  }

  .intro-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .intro-stats li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.1rem;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--color-ink);
  }

  .intro-stats :global(svg) {
    color: var(--color-primary);
  }

  .apartments-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.75rem;
  }

  .destination-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .destination-highlights {
    display: grid;
    gap: 1rem;
  }

  .destination-highlights li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--color-bg-alt);
    border-radius: var(--radius-md);
    padding: 1rem 1.1rem;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .destination-highlights :global(svg) {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .map-section {
    display: grid;
    gap: 2rem;
  }

  .contact-cta-inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .contact-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  @media (min-width: 900px) {
    .intro-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .destination-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .contact-cta-inner {
      grid-template-columns: 1.3fr 1fr;
    }

    .contact-cta-actions {
      justify-content: flex-end;
    }
  }
</style>
