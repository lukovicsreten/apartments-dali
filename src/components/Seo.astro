---
import { getImage } from 'astro:assets';
import { LOCALES, LOCALE_HTML, LOCALE_OG, DEFAULT_LOCALE, type Locale } from '../i18n/locales';
import { localePath } from '../i18n/utils';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Locale-agnostic path segments, e.g. [] for home, ['apartments', 'studio-1']. */
  path?: string[];
  image?: ImageMetadata;
}

const { title, description, locale, path = [], image } = Astro.props as Props;

const site = Astro.site ?? new URL('https://apartmentsdali.com');
const canonicalPath = localePath(locale, ...path);
const canonicalUrl = new URL(canonicalPath, site).toString();

const ogImagePath = image
  ? (await getImage({ src: image, width: 1200, height: 630, format: 'jpg', quality: 75 })).src
  : '/og-image.jpg';
const ogImage = new URL(ogImagePath, site).toString();
const fullTitle = `${title} | ${SITE.name}`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

{LOCALES.map((l) => (
  <link rel="alternate" hreflang={LOCALE_HTML[l]} href={new URL(localePath(l, ...path), site).toString()} />
))}
<link rel="alternate" hreflang="x-default" href={new URL(localePath(DEFAULT_LOCALE, ...path), site).toString()} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={LOCALE_OG[locale]} />
{LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={LOCALE_OG[l]} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
