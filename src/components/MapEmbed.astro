---
import { SITE } from '../data/site';

interface Props {
  title: string;
  height?: number;
}
const { title, height = 420 } = Astro.props as Props;
---

<div class="map-wrap" style={`--map-h:${height}px`}>
  <iframe
    src={SITE.mapsEmbedSrc}
    title={title}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
</div>

<style>
  .map-wrap {
    width: 100%;
    height: var(--map-h);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
  }

  .map-wrap iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
