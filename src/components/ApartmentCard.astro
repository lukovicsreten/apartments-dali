---
import { Image } from 'astro:assets';
import type { Apartment } from '../data/apartments';
import { getApartmentImages } from '../data/images';
import { localePath, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/locales';
import Icon from './Icon.astro';

interface Props {
  apartment: Apartment;
  locale: Locale;
  priority?: boolean;
  /** Card title heading level — pick whatever keeps the page's H1→H2→H3 order unbroken. */
  headingLevel?: 'h2' | 'h3';
}
const { apartment, locale, priority = false, headingLevel = 'h3' } = Astro.props as Props;
const Heading = headingLevel;
const t = useTranslations(locale);
const cover = getApartmentImages(apartment.slug)[0];
const guestsLabel = apartment.capacity === 1 ? t('apartments.guest_one') : t('apartments.guests');
---

<article class="card">
  <a class="card-media" href={localePath(locale, 'apartments', apartment.slug)}>
    {cover && (
      <Image
        src={cover}
        alt={`${apartment.name[locale]} — Apartments Dali, Budva`}
        width={640}
        height={440}
        widths={[320, 480, 640, 960]}
        sizes="(min-width: 900px) 380px, 90vw"
        format="webp"
        quality={72}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
      />
    )}
    {apartment.accessible && (
      <span class="a11y-badge" title={t('apartments.accessible')}>
        <Icon name="accessible" />
      </span>
    )}
  </a>
  <div class="card-body">
    <Heading><a href={localePath(locale, 'apartments', apartment.slug)}>{apartment.name[locale]}</a></Heading>
    <p class="card-desc">{apartment.description[locale]}</p>
    <div class="card-meta">
      <span><Icon name="users" /> {apartment.capacity} {guestsLabel}</span>
      <span><Icon name="ruler" /> {apartment.sizeM2} m²</span>
    </div>
    <a class="btn btn-secondary card-cta" href={localePath(locale, 'apartments', apartment.slug)}>
      {t('apartments.viewMore')}
      <Icon name="arrowRight" />
    </a>
  </div>
</article>

<style>
  .card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
    height: 100%;
  }

  .card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }

  .card-media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card:hover .card-media :global(img) {
    transform: scale(1.045);
  }

  .a11y-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: #fff;
    color: var(--color-accent-dark);
    border-radius: 50%;
    width: 2.1rem;
    height: 2.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-sm);
  }

  .card-body {
    padding: 1.4rem 1.4rem 1.6rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-body h2,
  .card-body h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .card-body h2 a:hover,
  .card-body h3 a:hover {
    color: var(--color-primary);
  }

  .card-desc {
    font-size: 0.92rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    display: flex;
    gap: 1.1rem;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    font-weight: 600;
    margin-bottom: 1.1rem;
  }

  .card-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .card-cta {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
